from PIL import Image, ImageDraw, ImageFont

renkler = {'siyah': (30,30,30), 'mavi': (0,100,250), 'kirmizi': (220,20,20), 'sari': (255,160,0)}
w, h = 180, 240 # Okey taşı dikdörtgen oranı (3:4)

def yeni_set_uret():
    for renk_ad, rgb in renkler.items():
        for sayi in range(1, 13): 
            img = Image.new('RGBA', (w, h), (0, 0, 0, 0))
            d = ImageDraw.Draw(img)
            d.rounded_rectangle([2, 2, 178, 238], radius=15, fill=(255, 255, 255), outline=(220, 220, 220), width=2)
            
            # SAYI PUNTOSUNU 70'TEN 40'A DÜŞÜRDÜK (Taş küçülünce sığması için)
            font = ImageFont.truetype('arialbd.ttf', 40) 
            d.text((90, 80), str(sayi), fill=rgb, font=font, anchor="mm")
            
            # Alt kısım: Çember ve Kalp
            d.ellipse([75, 150, 105, 180], outline=rgb, width=2)
            
            img.save(f'{renk_ad}_{sayi}.png')
    print("96 taş için küçük puntolu resimler üretildi!")

yeni_set_uret()