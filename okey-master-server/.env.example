# Sunucu Portu
PORT=3000
NODE_ENV=development

# PostgreSQL Veritabanı Bağlantı URL'i (Örn: Railway, Supabase veya Yerel PostgreSQL)
# Format: postgresql://[KULLANICI]:[SIFRE]@[HOST]:[PORT]/[VERITABANI]?sslmode=[SSL_MODU]
DATABASE_URL="postgresql://postgres:sifreniz@localhost:5432/okey_master?sslmode=disable"

# Firebase Admin SDK Bilgileri
# Firebase Console -> Proje Ayarları -> Hizmet Hesapları -> "Yeni özel anahtar oluştur"
FIREBASE_PROJECT_ID="proje-id-buraya"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@proje-id.iam.gserviceaccount.com"

# Firebase Özel Anahtarı (Tırnaklar içerisinde, \n karakterleri korunarak girilmelidir)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nBURAYA_FIREBASE_PRIVATE_KEY_GELECEK\n-----END PRIVATE KEY-----\n"
